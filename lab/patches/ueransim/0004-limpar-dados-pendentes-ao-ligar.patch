--- a/src/ue/nas/sm/resource.cpp
+++ b/src/ue/nas/sm/resource.cpp
@@ -70,6 +70,26 @@ void NasSm::handleUplinkStatusChange(int psi, bool isPending)
     m_mm->triggerMmCycle();
 }
 
+// Limpa o estado "dados de subida pendentes" de todas as sessões.
+//
+// handleUplinkDataRequest() descarta o pacote que chega com o UE em CM-IDLE: guarda apenas o
+// sinalizador uplinkPending, que serve para pedir a ligação. O sinalizador só era limpo quando um
+// pacote era ENVIADO já com a ligação estabelecida, por isso um dispositivo que transmita um único
+// pacote de cada vez ficava com ele preso a true para sempre: ao voltar a idle, o pacote seguinte
+// encontrava uplinkPending == true, não pedia ligação nenhuma e o dispositivo nunca mais acordava.
+void NasSm::clearUplinkDataPending()
+{
+    for (int psi = 1; psi < 16; psi++)
+    {
+        auto *ps = m_pduSessions[psi];
+        if (ps && ps->uplinkPending)
+        {
+            ps->uplinkPending = false;
+            m_logger->debug("Uplink data status changed PSI[%d] pending[false]", psi);
+        }
+    }
+}

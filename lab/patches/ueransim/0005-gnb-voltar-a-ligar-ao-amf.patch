@@ -29,17 +29,62 @@ void NgapTask::onStart()
         m_logger->warn("No AMF configuration is provided");
 
     for (auto &amfCtx : m_amfCtx)
+        connectAmf(amfCtx.second);
+
+    // Se o AMF ainda não estiver pronto, a primeira tentativa falha: voltar a tentar

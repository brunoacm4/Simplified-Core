+}
+
+void NgapTask::connectAmf(NgapAmfContext *amf)
+{
+    auto msg = std::make_unique<NmGnbSctp>(NmGnbSctp::CONNECTION_REQUEST);
+    msg->clientId = amf->ctxId;
+    msg->localAddress = m_base->config->ngapIp;
+    msg->localPort = 0;
+    msg->remoteAddress = amf->address;
+    msg->remotePort = amf->port;
+    msg->ppid = sctp::PayloadProtocolId::NGAP;
+    msg->associatedTask = this;
+    m_base->sctpTask->push(std::move(msg));
+}
+
+/*
+ * Volta a ligar aos AMFs configurados que não estão ligados (associação perdida ou tentativa falhada),
+ * e repete enquanto houver algum por ligar. As células continuam no ar: o NG Setup seguinte não volta a
+ * ligar o rádio, porque o gNB já está inicializado.
+ */
+void NgapTask::reconnectAmfs()
+{
+    bool pending = false;
+
+    for (auto &amfConfig : m_base->config->amfConfigs)
     {
-        auto msg = std::make_unique<NmGnbSctp>(NmGnbSctp::CONNECTION_REQUEST);
-        msg->clientId = amfCtx.second->ctxId;
-        msg->localAddress = m_base->config->ngapIp;
-        msg->localPort = 0;
-        msg->remoteAddress = amfCtx.second->address;
-        msg->remotePort = amfCtx.second->port;
-        msg->ppid = sctp::PayloadProtocolId::NGAP;
-        msg->associatedTask = this;
-        m_base->sctpTask->push(std::move(msg));
+        NgapAmfContext *amf = nullptr;
+        for (auto &ctx : m_amfCtx)
+            if (ctx.second->address == amfConfig.address && ctx.second->port == amfConfig.port)
+                amf = ctx.second;
+
+        // Ligado ou à espera da resposta ao NG Setup
+        if (amf != nullptr && amf->state != EAmfState::NOT_CONNECTED)
+            continue;
+
+        // Tentativa anterior falhou: fechar o que tiver ficado no SCTP e recomeçar
+        if (amf != nullptr)
+        {
+            auto w = std::make_unique<NmGnbSctp>(NmGnbSctp::CONNECTION_CLOSE);
+            w->clientId = amf->ctxId;
+            m_base->sctpTask->push(std::move(w));
+            deleteAmfContext(amf->ctxId);
+        }
+
+        m_logger->info("Trying to reconnect to AMF %s:%d", amfConfig.address.c_str(), amfConfig.port);
+        connectAmf(createAmfContext(amfConfig));
+        pending = true;
     }
+
+    if (pending)
+        setTimer(TIMER_ID_AMF_RECONNECT, static_cast<int64_t>(m_base->config->amfReconnect) * 1000);
 }
 

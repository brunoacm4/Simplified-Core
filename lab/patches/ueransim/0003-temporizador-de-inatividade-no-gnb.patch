+// Regista tráfego do utilizador (subida ou descida) para o temporizador de inatividade.
+void GtpTask::markActivity(int ueId)
+{
+    if (m_base->config->inactivityTimer <= 0)
+        return;
+
+    auto it = m_ueContexts.find(ueId);
+    if (it != m_ueContexts.end())
+        it->second->lastActivity = utils::CurrentTimeMillis();
+}
+
+// Corre uma vez por segundo. Pede a libertação dos UEs sem tráfego do utilizador há mais tempo do que
+// o configurado. Só são considerados os UEs com sessão PDU, porque um UE a meio do registo ou do
+// estabelecimento da sessão ainda não tem contexto aqui: nunca é cortado a meio de um procedimento.
+void GtpTask::checkInactivity()
+{
+    const int64_t inactivityMs = static_cast<int64_t>(m_base->config->inactivityTimer) * 1000LL;
+    const int64_t minConnectionMs = static_cast<int64_t>(m_base->config->minConnectionTime) * 1000LL;
+    const int64_t now = utils::CurrentTimeMillis();
+
+    for (auto &item : m_ueContexts)
+    {
+        auto &ue = item.second;
+
+        if (now - ue->createdAt < minConnectionMs)
+            continue;
+        if (now - ue->lastActivity < inactivityMs)
+            continue;
+
+        m_logger->debug("UE[%d] inactive for %d seconds, requesting context release", ue->ueId,
+                        static_cast<int>((now - ue->lastActivity) / 1000LL));
+
+        // Evita repetir o pedido a cada segundo enquanto o core responde.
+        ue->lastActivity = now;
+
+        auto w = std::make_unique<NmGnbGtpToNgap>(NmGnbGtpToNgap::UE_INACTIVE);
+        w->ueId = ue->ueId;
+        m_base->ngapTask->push(std::move(w));
+    }
+}

+/*
+ * Contador de subida da última mensagem enviada (a mensagem inicial a que este Security Mode Command
+ * responde). Depois de proteger uma mensagem, o contexto já guarda o contador seguinte (countOnEncrypt),
+ * mas a TS 33.501 (Anexo A.13 e §6.9.3) deriva o K_AMF' com o contador usado no Registration Request.
+ */
+static NasCount LastUsedUplinkCount(const NasCount &next)
+{
+    NasCount count = next;
+    count.sqn = static_cast<uint8_t>(((int)next.sqn - 1) & 0xFF);
+    if ((int)next.sqn == 0)
+        count.overflow = octet2(((int)next.overflow - 1) & 0xFFFF);
+    return count;
+}

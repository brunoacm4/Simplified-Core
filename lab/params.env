# PANIC -- parametros unicos do laboratorio
#
# FONTE DE VERDADE. Qualquer valor aqui presente aparece replicado nos ficheiros
# de configuracao do Open5GS e do UERANSIM. O script `check-params.sh` verifica
# que nao divergiram: PLMN/TAC/slice desalinhados sao a causa numero 1 de falhas
# de registo, e falham de forma silenciosa e confusa.

# --- Versoes (fixadas: um rebuild daqui a um ano tem de dar o mesmo codigo) ---
OPEN5GS_TAG=v2.7.7
UERANSIM_TAG=v3.3.0

# --- Identidade da rede ------------------------------------------------------
MCC=999
MNC=70
TAC=1
SST=1
# Sem SD: mantemos o slice mais simples possivel no baseline.
DNN=internet

# --- Enderecamento por interface 3GPP ----------------------------------------
# Redes separadas para que cada captura seja limpa e atribuivel a uma interface.
# IPs estaticos em todo o lado: elimina ambiguidade no bind das NFs multi-homed
# e torna as capturas legiveis sem tabela de traducao.

# net-sbi 10.55.0.0/24 -- HTTP/2 entre NFs
IP_MONGO=10.55.0.5
IP_NRF=10.55.0.10
IP_SCP=10.55.0.11
IP_AUSF=10.55.0.20
IP_UDM=10.55.0.21
IP_UDR=10.55.0.22
IP_PCF=10.55.0.23
IP_NSSF=10.55.0.24
IP_BSF=10.55.0.25
IP_AMF_SBI=10.55.0.30
IP_SMF_SBI=10.55.0.31

# net-n2n3 10.55.1.0/24 -- NGAP/SCTP (N2) e GTP-U (N3)
IP_AMF_NGAP=10.55.1.30
IP_UPF_GTPU=10.55.1.40
IP_GNB_N2N3=10.55.1.50

# net-n4 10.55.2.0/24 -- PFCP
IP_SMF_PFCP=10.55.2.31
IP_UPF_PFCP=10.55.2.40

# net-uu 10.55.3.0/24 -- radio simulado entre UE e gNB
IP_GNB_RADIO=10.55.3.50
IP_UE=10.55.3.60

# --- Plano de utilizador -----------------------------------------------------
UE_SUBNET=10.45.0.0/16
UE_GATEWAY=10.45.0.1
# 1400 e nao 1500: o GTP-U encapsula sobre uma bridge de MTU 1500. Sem isto ha
# fragmentacao, e qualquer medicao de plano de dados fica contaminada.
UE_MTU=1400

# --- Subscritor de teste -----------------------------------------------------
# Chaves de teste do Open5GS. Nao ha aqui nada sensivel: e um laboratorio.
TEST_IMSI=999700000000001
TEST_KI=465B5CE8B199B49FAA5F0A2EE238A6BC
TEST_OPC=E8ED289DEBA952E4283B54E88E6183CA
TEST_AMF_KEY=8000

# --- Desvios deliberados face a producao (ver docs/lab/topologia.md) ---------
# NAS_CIPHERING=NEA0  -> NAS legivel nas capturas (integridade mantida em NIA2)
# SBI_TLS=off         -> corpos JSON das chamadas entre NFs inspecionaveis
# Ambos revertiveis; o custo criptografico que removem sera medido a parte.
